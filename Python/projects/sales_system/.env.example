# Copia este archivo como .env y completa tus propios valores.
# Nunca subas el archivo .env real a un repositorio - ya está en .gitignore.

# Access Token de Mercado Pago (usa el de PRUEBA mientras desarrollas).
# Se obtiene en: Tus integraciones -> tu aplicación -> Credenciales de prueba.
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Clave para las rutas administrativas (crear/editar/eliminar productos, ver ventas).
# Genera una propia con: python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_API_KEY=

# Configuración de Flask
FLASK_DEBUG=true
FLASK_PORT=5000

# Orígenes permitidos por CORS. "*" para desarrollo local; en producción,
# reemplaza por el dominio real, por ejemplo: https://mi-tienda.com
CORS_ORIGINS=*

# Segundos de espera máximos para las llamadas a Mercado Pago
MERCADOPAGO_TIMEOUT=10
