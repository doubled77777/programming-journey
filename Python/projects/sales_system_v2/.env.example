# Copiar este archivo a ".env" y ajustar los valores.
# Nunca commitear el archivo ".env" real con secretos verdaderos.

# Clave usada por Flask para firmar las cookies de sesión.
# Generar una propia, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-por-una-generada-aleatoriamente

# Ruta al archivo de base de datos SQLite.
DATABASE_PATH=database/sales.db

# Minutos de duración de la sesión de login antes de expirar.
SESSION_LIFETIME_MINUTES=60

# development | testing | production
FLASK_ENV=development
